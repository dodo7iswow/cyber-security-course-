# BeautyBook Haiti - Backend Environment Variables

# Application
APP_NAME="BeautyBook Haiti"
DEBUG=False

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/beautybook

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# MonCash API Configuration
# Get your credentials from: https://moncashbutton.digicelgroup.com/Moncash-business/
MONCASH_CLIENT_ID=your_moncash_client_id
MONCASH_CLIENT_SECRET=your_moncash_client_secret
MONCASH_MODE=sandbox  # Use 'sandbox' for testing, 'production' for live

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:19006,exp://localhost:19000

# File Upload
MAX_UPLOAD_SIZE=5242880  # 5MB in bytes
UPLOAD_DIR=uploads

# Email (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
